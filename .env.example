# apify_pinterest configuration. Read ONLY from this directory — the Etsy repo's
# .env is never consulted, so the two projects cannot drift into each other.

# THIS PROJECT'S OWN VAULT — port 6380, container `pinterest-redis`.
#
# It used to be 6379, the Etsy project's `scraper-redis`, shared by both. They
# never mixed data (separate `cookie:{platform}:*` namespaces) but they shared
# a process, so one project's container restart took the other's sessions with
# it. Separated 2026-08-25 with `python -m browsers.migrate_vault`, which
# copies only this platform's keys and leaves cookie:etsy* untouched.
#
#   local  : redis://localhost:6380/0  (docker: pinterest-redis)
#   Apify  : must be network-reachable (Upstash). Set it as an Actor SECRET,
#            never in actor.json. The same migrate_vault moves it there.
REDIS_URL=redis://localhost:6380/0

VAULT_PLATFORM=pinterest
PROFILE_MAX_AGE=900
LEASE_TTL=900
VAULT_WAIT_TIMEOUT=60

# curl_cffi TLS fingerprint. Keep it consistent with the browser the operator
# actually runs: the cookies, the User-Agent header and the TLS handshake are
# three claims about one browser, and a fingerprinter reads all three.
#
# `python -m src.status` warns when this drifts more than a few versions from
# what the vault's profiles actually announce. It drifted 26 versions unnoticed
# (profiles on Chrome 150, this pinned at chrome124) because the requests keep
# working either way — which is exactly why nothing surfaced it.
IMPERSONATE=chrome146
REQUEST_TIMEOUT=30

# There is no GLOBAL proxy setting, by design: `adspower/sync_cookies.py` writes
# one proxy per profile into that profile's vault hash, next to its cookies. A
# global would put two accounts behind one exit IP.
#
# REQUIRE_PROXY refuses to lease a profile that has none, because such a profile
# exits from whatever host the run is on — mixing a datacentre identity with a
# residential one for the same Pinterest account. Leave it on unless this
# machine has no proxies at all, in which case the pool is not mixed and there
# is nothing to protect against.
REQUIRE_PROXY=1
