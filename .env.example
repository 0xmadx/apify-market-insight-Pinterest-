# apify_pinterest configuration. Read ONLY from this directory — the Etsy repo's
# .env is never consulted, so the two projects cannot drift into each other.

# The shared vault. This is the one thing both projects touch, because the
# Chrome extension writes the sessions here.
#   local  : the Docker Redis the Go cookie server writes to
#   Apify  : must be network-reachable (Upstash / VPS). Set it as an Actor
#            SECRET, never in actor.json.
REDIS_URL=redis://localhost:6379/0

VAULT_PLATFORM=pinterest
PROFILE_MAX_AGE=900
LEASE_TTL=900
VAULT_WAIT_TIMEOUT=60

# curl_cffi TLS fingerprint. Keep it consistent with the browser the operator
# actually runs, since the vault hands back that browser's real user agent.
IMPERSONATE=chrome124
REQUEST_TIMEOUT=30

# Phase 1 has no proxy settings at all, by design. Phase 2 writes one proxy per
# profile into the vault hash next to that profile's cookies — never a global.
