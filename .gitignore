.env
.venv/
storage/
apify_storage/
__pycache__/
*.pyc
# Scratch files (_geo.py and friends). This rule exists because four of them
# were swept into commits by `git add -A`.
_*.py
# ...but it also matched __init__.py, silently leaving browsers/ untracked as a
# package. It kept working via PEP 420 namespace packages, which is luck rather
# than design — the file existed locally and would simply be absent in a fresh
# clone, so the gap could not surface on the machine that created it.
!**/__init__.py

# Live Pinterest sessions and proxy passwords, in clear text.
browsers/*.json
# Per-profile Chromium user-data: cookies, history, cache. Same sensitivity as
# identities.json, and hundreds of megabytes besides.
browsers/profiles/

# Every .env variant, not just `.env`. A `.env.backup-premigration` was
# committed on 2026-08-25 because the rule only matched the exact name — it
# was a verbatim copy of .env, API keys included.
.env*
!.env.example

# The DeepSeek cost/usage log (tools/deepseek.py). Local operational history,
# not code — and its "prompt_preview" field is a 60-char snippet of whatever
# was drafted, which does not belong in a shared repo even in preview form.
tools/.deepseek_usage.jsonl
